{
  "name": "thrift-apparel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "server": "node server/server.js",
    "server:dev": "nodemon server/server.js",
    "client": "cd client && npm run dev -- --host 0.0.0.0",
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "build": "cd client && npm install && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.10"
  }
}
